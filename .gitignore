/target
**/*.rs.bk

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*.swo

# Архивы в корне — обычно исходники шрифтов / выгрузок, не для репо.
/*.zip
/*.tar
/*.tar.gz

# Локальные утилиты — бинарники >100MB не принимает GitHub.
# Скачать: https://www.gyan.dev/ffmpeg/builds/ (full build, 2022-09-15)
/utils/ffmpeg.exe

# Автосохранённая сессия — рабочий артефакт, не для репо.
*.lsession
last_session.db

# Оркестратор: стоп-файлы, файлы статуса и состояния сессии.
/scripts/.stop-*
/scripts/.jobstatus-*
/scripts/.session-*.json
/scripts/.coder-session-*.json
# Coders solo worklog: отчёт о наработках, ожидающих влития; чистится Claude после merge.
/scripts/coders-worklog.md
# Kilo debug-логи обмена (тайминг/детали троттлинга) — транзиентные.
/scripts/coder-debug-*.log
# Отчёты визуальной приёмки nano-omni; чистятся Claude после merge ветки.
/scripts/vision-reports/
/.jobstatus-*
__pycache__/
# PERF-6 session-health journal — local, per-session, never committed.
/health.log

# Графические тесты: рабочие скрины (Edge-эталон, Lumen-захват, diff) — не коммитим.
# См. CLAUDE.md → «Графические тесты», правило №1.
/graphic_tests/screenshots/
/graphic_tests/debug/
# results/*.json коммитятся (история прогонов в git); HTML-отчёты — нет (ссылаются на gitignored PNG).
/graphic_tests/results/*.html

# Личная временная папка ассистента (скриншоты --screenshot, черновые артефакты).
# Всё рабочее держим в папке проекта, не в системном temp.
/.tmp/

# P2-wpt: MANIFEST.json + wptrunner's own mtime cache are regenerated by
# `wptrunner --manifest-update` from the vendored test tree
# (tests/wpt/run_smoke.py); `.ini` expectations that will live alongside them
# from S5 onward are NOT covered by these patterns.
/tests/wpt/metadata/MANIFEST.json
/tests/wpt/metadata/.cache/
# WPT-RUN-4: run_corpus.py's own manifest cache, regenerated per run
/tests/wpt/.wptcache/
last_session.db-shm
last_session.db-wal

# A/B baseline binaries built by scripts/perf-baseline.sh (кэш по SHA, ~79 МБ на запись)
/.claude/perf-baseline/

# Мусор от прогонов в корне: логи с префиксом `.tmp_` (правило /.tmp/ ловит
# только папку) и стек-дампы упавших утилит. Файлы не удаляем — просто не
# версионируем.
/.tmp_*.log
/*.stackdump

# Экспорты логов сессий (кладутся в корень для разбора, в репозитории не нужны).
/Lumen browser_*.md

# Рабочая папка вариантов дизайна: уникальные варианты лежат в
# docs/design/variants/, lumen-v3_3.html совпадает с docs/design/lumen-v3_3.html.
/Design_all_variants/

# Генерируемые индексы и деревья — НЕ версионируются (решение 2026-08-31).
# Оба файла — чистые производные (SYMBOLS.md от `crates/`, деревья от
# ROADMAP.md + BUGS.md + CSS-SPECS.md), и оба генератора отрабатывают меньше чем
# за 2 с: `python scripts/gen_symbols.py`, `python scripts/gen_roadmap.py`.
# Пока они лежали в индексе, их приходилось перегенерировать в каждом коммите,
# сдвигающем строки — за 300 коммитов два дерева оказались двумя самыми часто
# изменяемыми файлами репозитория (66 правок, впереди самого ROADMAP.md), а
# SYMBOLS.md пятым (54), и при трёх параллельных ролях это давало конфликт
# почти в каждом merge. CI (джоб doc-drift) теперь проверяет, что генераторы
# ЗАПУСКАЮТСЯ и дерево не обрезано, а не что результат совпадает побайтно.
/SYMBOLS.md
/docs/roadmap-B-twotrees.html
/docs/roadmap-svg-cleaves.html
